{
  "name": "skilltrack-backend",
  "version": "1.0.0",
  "description": "SKILLTRACK Backend - Employee Learning, Skill Development and Compliance Management Platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:integration": "jest tests/integration/ --runInBand --detectOpenHandles",
    "test:production": "jest tests/production-readiness.test.js --runInBand --detectOpenHandles",
    "seed:learning": "node src/seeds/integratedLearningSeeder.js"
  },
  "keywords": [
    "skilltrack",
    "mern",
    "backend",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
