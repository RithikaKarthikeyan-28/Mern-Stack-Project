# ==============================================================================
# SkillTrack Backend — Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your deployment environment.
# NEVER commit .env or files with real production secrets to version control.
# ==============================================================================

# Server Environment & Networking
# Supported NODE_ENV: development, test, production
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB URI)
# In production, provide authenticated connection string (e.g. mongodb://user:pass@host:27017/skilltrack)
MONGO_URI=mongodb://127.0.0.1:27017/skilltrack

# Authentication & JWT Security
# In production, JWT_SECRET must be a cryptographically strong secret >= 32 characters
JWT_SECRET=replace-with-a-secure-production-secret-min-32-chars
JWT_EXPIRES_IN=7d

# CORS (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins. Wildcard "*" is strictly forbidden in production.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# HTTP Request Body Size Limit
BODY_LIMIT=10kb

# Rate Limiting Configuration
# Sliding window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# General API maximum requests per sliding window
RATE_LIMIT_MAX=1000
# Strict maximum requests per window for sensitive authentication endpoints (/api/auth/register, /api/auth/login)
AUTH_RATE_LIMIT_MAX=10

# Business Domain & Lifecycle Configuration
# Standard certificate validity period in days (default: 365)
CERTIFICATE_VALIDITY_DAYS=365
# Window prior to certificate expiry where renewal becomes eligible (default: 30)
CERTIFICATE_RENEWAL_WINDOW_DAYS=30
# Threshold in days prior to deadline where compliance transitions to DUE_SOON (default: 30)
COMPLIANCE_DUE_SOON_DAYS=30

# Client Application URL (used in email download & verification links)
CLIENT_URL=http://localhost:5173

# Email Delivery Configuration (Optional - SMTP)
# When omitted, the platform uses transactional audit logging and tracks delivery status.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkillTrack Learning <noreply@skilltrack.local>

